# Aion Development Environment
# ============================
# Copy this file to .env and customize as needed

# Application
APP_NAME=Aion
APP_VERSION=0.1.0
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","tauri://localhost"]

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aion
POSTGRES_PASSWORD=aion_local_secret
POSTGRES_DB=aion

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aion_embeddings

# Ollama (Local LLM)
# Use 0.0.0.0 to allow connections from other devices on your network
# Or keep localhost if you only want local access
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# File Storage
DATA_DIR=./data
MAX_FILE_SIZE_MB=100
