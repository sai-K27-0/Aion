<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for Aion Mobile
    
    PRODUCTION: All traffic requires HTTPS/TLS
    DEBUG: Allows cleartext for local development servers only
    
    Note: This file is used for release builds.
    Debug builds use debug/AndroidManifest.xml which allows cleartext.
-->
<network-security-config>
    <!-- Default: Require HTTPS for all domains (production security) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- 
        Development domains - Only for testing
        In production, your server should use HTTPS
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator host -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Localhost for iOS simulator -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
